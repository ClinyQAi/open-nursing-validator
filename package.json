{
  "name": "open-nursing-validator",
  "version": "1.0.0",
  "description": "FHIR R4 validation API for the Open Nursing Core Implementation Guide (ONC-IG)",
  "main": "dist/server.js",
  "scripts": {
    "start": "ts-node src/server.ts",
    "start:prod": "node dist/server.js",
    "build": "npm run build:client && npm run build:server",
    "build:client": "cd client && npm run build",
    "build:server": "tsc --outDir dist",
    "test": "jest",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^10.0.0",
    "express": "^4.17.1",
    "express-rate-limit": "^8.3.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.562.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^5.1.3",
    "@types/helmet": "^0.0.48",
    "@types/jest": "^27.5.2",
    "@types/node": "^24.10.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^7.32.0",
    "jest": "^30.4.2",
    "prettier": "^2.5.1",
    "ts-jest": "^27.0.6",
    "ts-node": "^10.4.0",
    "typescript": "^4.4.4"
  },
  "keywords": [
    "nursing",
    "fhir",
    "validation",
    "healthcare",
    "open-nursing-core"
  ],
  "author": "Lincoln Gombedza <lincolngombedza@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ClinyQAi/nhs-unified-nursing-validator.git"
  },
  "homepage": "https://clinyqai.github.io/open-nursing-core-ig/",
  "overrides": {
    "rollup": ">=4.59.0",
    "postcss": ">=8.5.10",
    "vite": ">=7.3.2",
    "picomatch": ">=4.0.4",
    "lodash": ">=4.18.0"
  }
}